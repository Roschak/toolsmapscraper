generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
  ANALYST
  VIEWER
}

enum JobStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum WebsiteStatus {
  WEBSITE_LISTED
  WEBSITE_DISCOVERED
  NO_WEBSITE_LISTED
  POSSIBLE_WEBSITE
  WEBSITE_UNCERTAIN
  SOCIAL_ONLY
}

enum EntityMatchConfidence {
  EXACT_MATCH
  HIGH_CONFIDENCE_MATCH
  PROBABLE_MATCH
  POSSIBLE_MATCH
  NO_MATCH
}

enum LeadPriority {
  HOT
  HIGH
  MEDIUM
  LOW
  VERY_LOW
}

enum LeadStatus {
  NEW
  RESEARCHED
  DEMO_CREATED
  DEMO_READY
  CONTACTED
  FOLLOW_UP
  INTERESTED
  NEGOTIATION
  CLIENT
  NO_RESPONSE
  NOT_INTERESTED
  LOST
  ARCHIVED
}

enum DemoStatus {
  NOT_CREATED
  IN_PROGRESS
  READY
  SENT
  APPROVED
  REJECTED
}

enum SourceType {
  GOOGLE_PLACES
  FOURSQUARE
  OVERTURE
  GEOAPIFY
  USER_IMPORT
  MANUAL
  MOCK_PROVIDER
  OTHER_APPROVED_SOURCE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(SALES)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model BusinessEntity {
  id              String     @id @default(uuid())
  canonicalName   String
  providerIds     Json?
  country         String?
  region          String?
  city            String?
  district        String?
  address         String?
  latitude        Float?
  longitude       Float?
  categories      String[]
  primaryCategory String?
  businessModel   String?
  legalEntity     String?
  phone           String?
  website         String?
  socialLinks     Json?
  rating          Float?
  reviewCount     Int?
  businessStatus  String?
  sourceProviders String[]
  dataConfidence  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastVerifiedAt  DateTime?
  prospects       Prospect[]

  @@index([canonicalName])
  @@index([country, city])
}

model Prospect {
  id                       String          @id @default(uuid())
  businessEntityId         String?
  businessEntity           BusinessEntity? @relation(fields: [businessEntityId], references: [id])
  searchJobId              String?
  searchJob                SearchJob?      @relation(fields: [searchJobId], references: [id])
  sourceType               SourceType
  businessName             String
  classification           String?
  classificationConfidence Float?
  businessModel            String?
  businessModelConfidence  Float?
  websiteStatus            WebsiteStatus   @default(NO_WEBSITE_LISTED)
  websiteUrl               String?
  websiteConfidence        Float?
  phone                    String?
  country                  String?
  region                   String?
  city                     String?
  address                  String?
  latitude                 Float?
  longitude                Float?
  rating                   Float?
  reviewCount              Int?
  businessStatus           String?
  leadScore                Float?
  priority                 LeadPriority?
  leadStatus               LeadStatus      @default(NEW)
  demoStatus               DemoStatus      @default(NOT_CREATED)
  demoUrl                  String?
  notes                    String?
  assignedTo               String?
  tags                     String[]
  customFields             Json?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  lastVerifiedAt           DateTime?
  leadNotes                LeadNote[]

  @@index([leadStatus])
  @@index([priority])
  @@index([websiteStatus])
  @@index([country, city])
  @@index([leadScore])
}

model LeadNote {
  id         String   @id @default(uuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String?
  content    String
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

model SearchJob {
  id                      String     @id @default(uuid())
  name                    String
  country                 String?
  region                  String?
  city                    String?
  district                String?
  category                String?
  keywords                String?
  query                   String?
  scope                   String?
  provider                String?
  status                  JobStatus  @default(QUEUED)
  progress                Float      @default(0)
  totalTasks              Int        @default(0)
  completedTasks          Int        @default(0)
  failedTasks             Int        @default(0)
  resultCount             Int        @default(0)
  duplicateCount          Int        @default(0)
  websiteListedCount      Int        @default(0)
  websiteOpportunityCount Int        @default(0)
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime   @default(now())
  error                   String?
  prospects               Prospect[]

  @@index([status])
}

model ExportJob {
  id          String    @id @default(uuid())
  format      String    @default("CSV")
  query       Json?
  status      JobStatus @default(QUEUED)
  fileUrl     String?
  recordCount Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
}
