# ============================================================
# PROJECT-PROSPECTHUNTER CONFIGURATION TEMPLATE
# ============================================================

NODE_ENV=development
APP_URL=http://localhost:3005
API_URL=http://localhost:4000

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
# Option A: Supabase Cloud PostgreSQL (Recommended)
# Transaction Pooler (Port 6543) - Gunakan ini untuk DATABASE_URL:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct Connection (Port 5432) - Gunakan ini untuk DIRECT_URL (migrasi & push):
# DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Option B: Local PostgreSQL (Port 5433)
DATABASE_URL=postgresql://postgres:password@localhost:5433/prospecthunter?schema=public

# Redis & Cache (Optional)
REDIS_URL=redis://localhost:6379

# ClickHouse (Optional)
CLICKHOUSE_URL=http://localhost:8123

# Providers API Keys (Optional, OSM scraper is active without keys)
GOOGLE_MAPS_API_KEY=
FOURSQUARE_API_KEY=
GEOAPIFY_API_KEY=
OVERTURE_MAPS_ENABLED=true

# Storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Security & Authentication
AUTH_SECRET=prospecthunter-secret-jwt-key-ultra-secure-random-2026-auth
JWT_EXPIRES_IN=7d

# Search & Mock Controls
MOCK_MODE=true
SEARCH_DAILY_LIMIT=50000
SEARCH_MONTHLY_LIMIT=1000000
SEARCH_JOB_LIMIT=500
EXPORT_RETENTION_DAYS=30
