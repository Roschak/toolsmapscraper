# ============================================================
# PROJECT-PROSPECTHUNTER CONFIGURATION TEMPLATE
# ============================================================

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5433/prospecthunter?schema=public

# Redis & Cache
REDIS_URL=redis://localhost:6379

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123

# Providers API Keys
GOOGLE_MAPS_API_KEY=
FOURSQUARE_API_KEY=
GEOAPIFY_API_KEY=
OVERTURE_MAPS_ENABLED=true

# Storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Security & Authentication
AUTH_SECRET=change-this-to-a-very-secure-random-key-in-production
JWT_EXPIRES_IN=7d

# Search & Mock Controls
MOCK_MODE=true
SEARCH_DAILY_LIMIT=50000
SEARCH_MONTHLY_LIMIT=1000000
SEARCH_JOB_LIMIT=500
EXPORT_RETENTION_DAYS=30
