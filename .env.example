# ============================================================
# PROJECT-PROSPECTHUNTER CONFIGURATION TEMPLATE
# ============================================================

NODE_ENV=development
APP_URL=http://localhost:3005
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ============================================================
# 1. DATABASE CONFIGURATION
# ============================================================
# Option A: Supabase Cloud PostgreSQL
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Option B: Local PostgreSQL (Port 5433)
DATABASE_URL=postgresql://postgres:password@localhost:5433/prospecthunter?schema=public

# ============================================================
# 2. SUPABASE API & AUTH KEYS
# ============================================================
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ============================================================
# 3. SECURITY & AUTHENTICATION
# ============================================================
AUTH_SECRET=prospecthunter-secret-jwt-key-ultra-secure-random-2026-auth
JWT_EXPIRES_IN=7d

# ============================================================
# 4. SCRAPING PROVIDERS & API KEYS
# ============================================================
MOCK_MODE=true
OVERTURE_MAPS_ENABLED=true
GOOGLE_MAPS_API_KEY=
FOURSQUARE_API_KEY=
GEOAPIFY_API_KEY=

# ============================================================
# 5. LIMITS & ENGINE SETTINGS
# ============================================================
SEARCH_DAILY_LIMIT=50000
SEARCH_MONTHLY_LIMIT=1000000
SEARCH_JOB_LIMIT=500
EXPORT_RETENTION_DAYS=30

# ============================================================
# 6. CACHE & STORAGE (Optional)
# ============================================================
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
