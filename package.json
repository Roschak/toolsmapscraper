{
  "name": "project-prospecthunter",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "pg": "^8.23.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @prospecthunter/database db:generate && pnpm -r --filter=!api --filter=!worker --filter=!web run build && pnpm --filter web build",
    "start": "pnpm --filter web start -p 3005",
    "api": "node apps/api/dist/main.js",
    "db:start": "powershell -Command \"& 'C:\\Program Files\\PostgreSQL\\18\\bin\\pg_ctl.exe' -D './data/pgdata' -l './data/postgres.log' -o '-p 5433' start\"",
    "db:stop": "powershell -Command \"& 'C:\\Program Files\\PostgreSQL\\18\\bin\\pg_ctl.exe' -D './data/pgdata' stop\"",
    "db:status": "powershell -Command \"& 'C:\\Program Files\\PostgreSQL\\18\\bin\\pg_ctl.exe' -D './data/pgdata' status\"",
    "seed": "node scripts/seed.ts",
    "test": "node --test tests/pipeline.test.mjs",
    "test:all": "pnpm -r run test",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "next": "14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3"
  }
}
